      "priority": 1,
      "technique": "Read redundant numeric displays in the same captured frame when visible",
      "purpose": "Add independent pixel evidence for an exact value; verify character/resource identity and expose disagreement.",
      "status": "Proposed, not benchmarked; shared font errors may remain correlated."
    },
    {
      "priority": 2,
      "technique": "Use own-character HP/Mana bar fill as a value interval",
      "purpose": "Reject candidates inconsistent with a verified current maximum and calibrated bar geometry.",
      "limits": "Bar quantization, endpoint error, identity, occlusion and update timing must be measured. Multiple compatible integers remain UNKNOWN; agreement is not independent exact verification.",
      "example": "5000 maximum HP across a 100-pixel fill span gives roughly 50 HP per pixel, before endpoint uncertainty.",
      "status": "Proposed, not benchmarked."
    },
    {
      "priority": 3,
      "technique": "Calibrate static HUD/background templates and local anchor tracking",
      "purpose": "Reduce cold/global reacquisition and stabilize value-cell geometry; revalidate visibility against the current frame.",
      "limits": "Background subtraction cannot recover missing text. Rendered numeric candidates need capture-matched scale/antialiasing; the native whole-number experiment already covers part of this approach.",
      "status": "Proposed extension to implemented font/geometry caches, not benchmarked."
    },
    {
      "priority": 4,
      "technique": "Short timestamped temporal evidence for demonstrably unchanged text",
      "purpose": "Resolve transient pixel noise while tracking rapid changes.",
      "limits": "Do not average HP values or report a previous readable value as current. Establish a separate freshness limit with real capture sequences.",
      "status": "Proposed, requires real sequence evaluation."
    }
